<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>MaskomApp | Masuk</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
        }
        .login-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.08);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-[440px]">
        <!-- Logo / Brand -->
        <div class="text-center mb-8">
            <div class="inline-flex p-3 bg-indigo-600/10 rounded-2xl text-indigo-600 mb-3">
                <span class="material-symbols-outlined text-4xl">dns</span>
            </div>
            <h1 class="text-3xl font-bold font-['Hanken_Grotesk'] text-slate-900">MaskomApp</h1>
            <p class="text-slate-500 mt-1.5 text-sm">Manajemen Infrastruktur IT & Aset Komputer</p>
        </div>

        <!-- Login Card -->
        <div class="login-card rounded-3xl p-8">
            <h2 class="text-xl font-semibold text-slate-800 mb-6">Silakan Masuk</h2>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-5 p-3.5 bg-red-50 border border-red-200 text-red-600 rounded-xl text-xs flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">error</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-2 uppercase tracking-wider">Username</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">person</span>
                        <input type="text" name="username" required
                            class="w-full pl-10 pr-4 py-3 bg-slate-50/80 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600 transition-all text-slate-800"
                            placeholder="Masukkan username">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-2 uppercase tracking-wider">Password</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">lock</span>
                        <input type="password" name="password" required
                            class="w-full pl-10 pr-4 py-3 bg-slate-50/80 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600 transition-all text-slate-800"
                            placeholder="••••••">
                    </div>
                </div>

                <button type="submit"
                    class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-xl transition-all shadow-lg shadow-indigo-600/20 active:scale-[0.98]">
                    Masuk
                </button>
            </form>
        </div>

        <!-- Footer -->
        <p class="text-center text-xs text-slate-400 mt-8">
            &copy; 2026 ProTech Infrastructure. All rights reserved.
        </p>
    </div>

</body>
</html>
