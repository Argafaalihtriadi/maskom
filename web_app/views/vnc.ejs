<!DOCTYPE html>
<html class="light" lang="id">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Remote Desktop - <%= ip %></title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; background: #1a1a2e; overflow: hidden; font-family: 'Inter', sans-serif; }
    #vnc-container { width: 100vw; height: 100vh; display: flex; flex-direction: column; }
    #vnc-toolbar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 8px 16px; background: #16213e; color: #fff;
        border-bottom: 1px solid #0f3460; flex-shrink: 0;
    }
    #vnc-toolbar .title { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
    #vnc-toolbar .title .status-dot {
        width: 10px; height: 10px; border-radius: 50%;
        background: #ef4444; transition: background 0.3s;
    }
    #vnc-toolbar .title .status-dot.connected { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.5); }
    #vnc-toolbar .actions { display: flex; gap: 8px; }
    #vnc-toolbar .actions button {
        padding: 6px 14px; border: 1px solid rgba(255,255,255,0.15);
        border-radius: 6px; background: rgba(255,255,255,0.08);
        color: #fff; cursor: pointer; font-size: 12px; transition: 0.2s;
    }
    #vnc-toolbar .actions button:hover { background: rgba(255,255,255,0.18); }
    #vnc-toolbar .actions button.danger:hover { background: rgba(239,68,68,0.3); border-color: #ef4444; }
    #vnc-screen {
        flex: 1; display: flex; align-items: center; justify-content: center;
        background: #0f0f23; position: relative;
    }
    #vnc-screen canvas { display: block; }
    #vnc-status {
        position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
        padding: 6px 16px; border-radius: 8px; font-size: 12px;
        background: rgba(0,0,0,0.7); color: #94a3b8;
        backdrop-filter: blur(8px); white-space: nowrap;
        transition: all 0.3s;
    }
    #vnc-status.connected { color: #22c55e; }
    #vnc-status.error { color: #ef4444; }
    #vnc-fullscreen-btn {
        position: absolute; top: 12px; right: 12px;
        padding: 6px 10px; border-radius: 6px;
        background: rgba(0,0,0,0.5); color: #fff; border: none;
        cursor: pointer; font-size: 18px; opacity: 0.5; transition: 0.2s;
    }
    #vnc-fullscreen-btn:hover { opacity: 1; }
    @media (max-width: 768px) {
        #vnc-toolbar .title span { display: none; }
    }
</style>
</head>
<body>
<div id="vnc-container">
    <div id="vnc-toolbar">
        <div class="title">
            <div class="status-dot" id="statusDot"></div>
            <span>Remote Desktop</span>
            <span style="color:#94a3b8;font-weight:400;font-size:12px"><%= ip %>:5900</span>
        </div>
        <div class="actions">
            <button onclick="sendKey('ctrl+alt+del')" title="Kirim Ctrl+Alt+Del">Ctrl+Alt+Del</button>
            <button onclick="sendKey('ctrl+esc')" title="Kirim Ctrl+Esc (Start Menu)">Start</button>
            <button onclick="sendKey('f8')" title="Kirim F8">F8</button>
            <button onclick="toggleClipboard()" title="Clipboard">📋</button>
            <button onclick="window.powerAction('<%= ip %>','restart')" style="border-color:#f59e0b40;color:#fbbf24">Restart</button>
            <button onclick="window.powerAction('<%= ip %>','shutdown')" style="border-color:#ef444440;color:#ef4444">Matikan</button>
            <button onclick="disconnect()" class="danger" title="Putuskan Koneksi">Putus</button>
        </div>
    </div>
    <div id="vnc-screen">
        <div id="vnc-status">Menghubungkan ke <%= ip %>...</div>
    </div>
</div>

<script type="module">
import RFB from '/novnc/core/rfb.js';

let rfb = null;

function connect() {
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const host = window.location.hostname;
    const port = window.location.port || 80;
    const url = `${protocol}//${host}:${port}/ws/vnc/<%= ip %>`;

    const statusEl = document.getElementById('vnc-status');
    const dotEl = document.getElementById('statusDot');

    statusEl.textContent = 'Menghubungkan...';
    statusEl.className = '';

    try {
        rfb = new RFB(document.getElementById('vnc-screen'), url, {
            credentials: { password: '<%= typeof password !== "undefined" ? password : "" %>' },
            shared: true
        });

        rfb.addEventListener('connect', () => {
            statusEl.textContent = 'Terhubung';
            statusEl.className = 'connected';
            dotEl.classList.add('connected');
        });

        rfb.addEventListener('disconnect', (e) => {
            statusEl.textContent = e.detail.clean ? 'Terputus' : 'Koneksi terputus';
            statusEl.className = 'error';
            dotEl.classList.remove('connected');
        });

        rfb.addEventListener('securityfailure', () => {
            statusEl.textContent = 'Gagal: Autentikasi ditolak';
            statusEl.className = 'error';
        });

        rfb.addEventListener('desktopname', (e) => {
            document.title = e.detail.name + ' - ' + '<%= ip %>';
        });

        rfb.scaleViewport = true;
        rfb.resizeSession = true;
        rfb.viewOnly = false;
    } catch (e) {
        statusEl.textContent = 'Error: ' + e.message;
        statusEl.className = 'error';
    }
}

function disconnect() {
    if (rfb) rfb.disconnect();
}

function sendKey(keys) {
    if (!rfb) return;
    const map = {
        'ctrl+alt+del': [0xFFE3, 0xFFE9, 0xFFFF],
        'ctrl+esc': [0xFFE3, 0xFF1B],
        'f8': [0xFFC7]
    };
    const k = map[keys];
    if (!k) return;
    k.forEach(key => rfb.sendKey(key, null));
}

function toggleClipboard() {
    if (!rfb) return;
    navigator.clipboard.readText().then(text => {
        rfb.clipboardPasteFrom(text);
    }).catch(() => {});
}

window.powerAction = function(ip, action) {
    if (!confirm((action === 'restart' ? 'Restart' : 'Shutdown') + ' PC ' + ip + '?')) return;
    fetch('/api/remote/shutdown', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ip, action })
    }).then(r => r.json()).then(d => {
        alert(d.success ? '✅ ' + d.message : '❌ ' + d.message);
    }).catch(() => alert('❌ Gagal'));
};

connect();
</script>
</body>
</html>