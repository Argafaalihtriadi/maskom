<!DOCTYPE html>
<html class="light" lang="id">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>
      ProTech Infrastructure | <%= typeof title !== 'undefined' ? title :
      'Dasbor' %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=Inter:wght@400;500;600&amp;family=Geist:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;600&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <style>
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
      .glass-panel {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(203, 213, 225, 0.5);
      }
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #f7f9fb;
      }
      ::-webkit-scrollbar-thumb {
        background: #d8dadc;
        border-radius: 10px;
      }

      /* =============================================
           PRINT / PDF EXPORT STYLES
           ============================================= */
      @media print {
        /* Reset: sembunyikan semua elemen UI */
        nav,
        aside,
        header,
        #sidebar,
        .sidebar,
        [class*="sidebar"],
        #btn-ftp-sync,
        #inv-sync-btn,
        button:not(.print-btn),
        .flex.gap-3 > button,
        .flex.gap-3 > a,
        .overflow-y-auto,
        #filterBadge,
        [id$="-toast"],
        .animate-pulse,
        script {
          display: none !important;
        }

        /* Layout dasar cetak */
        *,
        *::before,
        *::after {
          box-shadow: none !important;
          text-shadow: none !important;
        }

        html,
        body {
          width: 100%;
          height: auto;
          background: #ffffff !important;
          color: #111827 !important;
          font-family: "Inter", Arial, sans-serif;
          font-size: 10pt;
        }

        /* Konten utama ambil full width */
        .flex-1,
        main,
        [class*="p-lg"] {
          width: 100% !important;
          padding: 0 !important;
          overflow: visible !important;
        }

        /* Header laporan cetak */
        body::before {
          content: "ProTech Infrastructure — Laporan Inventaris";
          display: block;
          font-size: 18pt;
          font-weight: 700;
          color: #111827;
          border-bottom: 2px solid #494bd6;
          padding-bottom: 8px;
          margin-bottom: 16px;
        }

        body::after {
          content: "Dicetak pada: " attr(data-print-date);
          display: block;
          font-size: 9pt;
          color: #6b7280;
          margin-top: 4px;
          margin-bottom: 24px;
        }

        /* Tabel inventaris cetak */
        table {
          width: 100% !important;
          border-collapse: collapse !important;
          font-size: 8.5pt;
        }

        table thead {
          background-color: #f3f4f6 !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        table th,
        table td {
          border: 1px solid #d1d5db !important;
          padding: 5px 8px !important;
          text-align: left;
        }

        table th {
          font-weight: 700;
          color: #374151 !important;
          background-color: #e5e7eb !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        /* Badge status cetak */
        .bg-emerald-50,
        [class*="bg-status-success"] {
          background-color: #d1fae5 !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        /* KPI cards di dashboard */
        .grid.grid-cols-4 > div,
        [class*="rounded-xl"] {
          border: 1px solid #d1d5db !important;
          background: #fff !important;
          break-inside: avoid;
        }

        /* Hindari page break di tengah row */
        tr {
          page-break-inside: avoid;
        }

        /* Footer cetak */
        @page {
          size: A4 landscape;
          margin: 15mm 12mm;
        }
      }
    </style>

    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "inverse-primary": "#c0c1ff",
              "on-background": "#191c1e",
              "on-error-container": "#93000a",
              surface: "#f7f9fb",
              "secondary-container": "#dae2fd",
              "secondary-fixed": "#dae2fd",
              "secondary-fixed-dim": "#bec6e0",
              "surface-tint": "#494bd6",
              "on-secondary-container": "#5c647a",
              "tertiary-fixed": "#ffdcc5",
              "surface-container-low": "#f2f4f6",
              "error-container": "#ffdad6",
              "primary-fixed-dim": "#c0c1ff",
              tertiary: "#904900",
              "tertiary-fixed-dim": "#ffb783",
              "on-tertiary-container": "#fffbff",
              "surface-container-high": "#e6e8ea",
              "on-primary-fixed": "#07006c",
              "primary-container": "#6063ee",
              "surface-container": "#eceef0",
              "on-secondary-fixed-variant": "#3f465c",
              "on-tertiary-fixed-variant": "#703700",
              "on-tertiary-fixed": "#301400",
              background: "#f7f9fb",
              secondary: "#565e74",
              "on-surface": "#191c1e",
              "surface-bright": "#f7f9fb",
              "on-tertiary": "#ffffff",
              "surface-variant": "#e0e3e5",
              "on-error": "#ffffff",
              primary: "#4648d4",
              "surface-container-highest": "#e0e3e5",
              "inverse-on-surface": "#eff1f3",
              "surface-container-lowest": "#ffffff",
              "tertiary-container": "#b55d00",
              "on-secondary-fixed": "#131b2e",
              "on-surface-variant": "#464554",
              "primary-fixed": "#e1e0ff",
              "inverse-surface": "#2d3133",
              error: "#ba1a1a",
              "on-primary-container": "#fffbff",
              "on-primary": "#ffffff",
              "on-secondary": "#ffffff",
              outline: "#767586",
              "outline-variant": "#c7c4d7",
              "on-primary-fixed-variant": "#2f2ebe",
              "surface-dim": "#d8dadc",
              "status-success": "#22C55E",
              "status-warning": "#F59E0B",
              "status-error": "#EF4444",
            },
            borderRadius: {
              DEFAULT: "0.125rem",
              lg: "0.25rem",
              xl: "0.5rem",
              full: "0.75rem",
            },
            spacing: {
              xs: "4px",
              sm: "8px",
              gutter: "24px",
              lg: "24px",
              "margin-mobile": "16px",
              base: "4px",
              "margin-desktop": "40px",
              md: "16px",
              xl: "32px",
              "sidebar-width": "260px",
            },
            fontFamily: {
              "headline-lg": ["Hanken Grotesk"],
              "headline-md": ["Hanken Grotesk"],
              "headline-sm": ["Hanken Grotesk"],
              "label-md": ["Geist"],
              "label-sm": ["Geist"],
              "body-md": ["Inter"],
              "body-lg": ["Inter"],
              "mono-data": ["JetBrains Mono"],
            },
            fontSize: {
              "headline-lg": [
                "32px",
                {
                  lineHeight: "40px",
                  letterSpacing: "-0.02em",
                  fontWeight: "700",
                },
              ],
              "headline-md": [
                "24px",
                { lineHeight: "32px", fontWeight: "600" },
              ],
              "headline-sm": [
                "20px",
                { lineHeight: "28px", fontWeight: "600" },
              ],
              "label-md": [
                "14px",
                {
                  lineHeight: "20px",
                  letterSpacing: "0.01em",
                  fontWeight: "500",
                },
              ],
              "label-sm": ["12px", { lineHeight: "16px", fontWeight: "600" }],
              "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
              "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
              "mono-data": ["13px", { lineHeight: "20px", fontWeight: "400" }],
            },
          },
        },
      };
    </script>
  </head>
  <body
    class="bg-surface-container-lowest text-on-surface font-body-md selection:bg-primary/20"
  >
    <!-- SideNavBar -->
    <aside
      class="fixed left-0 top-0 h-full w-[260px] bg-surface-container-lowest border-r border-outline-variant flex flex-col py-lg gap-sm z-[60]"
    >
      <div class="px-6 mb-8">
        <h1 class="text-headline-sm font-headline-sm font-bold text-primary">
          ProTech Infrastructure
        </h1>
        <p
          class="text-label-sm font-label-sm text-on-surface-variant mt-1 uppercase tracking-wider"
        >
          Administrator Sistem
        </p>
      </div>
      <nav class="flex-1 px-4 space-y-1">
        <a
          class="flex items-center gap-3 px-4 py-3 <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'text-primary font-semibold bg-primary/5' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container' %> rounded-xl transition-all duration-200"
          href="/"
        >
          <span class="material-symbols-outlined" data-icon="dashboard"
            >dashboard</span
          >
          <span class="font-label-md text-label-md">Dasbor</span>
        </a>
        <a
          class="flex items-center gap-3 px-4 py-3 <%= typeof activePage !== 'undefined' && activePage === 'monitoring' ? 'text-primary font-semibold bg-primary/5' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container' %> transition-colors duration-200 rounded-xl"
          href="/monitoring"
        >
          <span class="material-symbols-outlined" data-icon="monitoring"
            >monitoring</span
          >
          <span class="font-label-md text-label-md">Monitoring</span>
        </a>
        <a
          class="flex items-center gap-3 px-4 py-3 <%= typeof activePage !== 'undefined' && activePage === 'inventory' ? 'text-primary font-semibold bg-primary/5' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container' %> transition-colors duration-200 rounded-xl"
          href="/inventory"
        >
          <span class="material-symbols-outlined" data-icon="inventory_2"
            >inventory_2</span
          >
          <span class="font-label-md text-label-md">Inventaris</span>
        </a>
        <a
          class="flex items-center gap-3 px-4 py-3 <%= typeof activePage !== 'undefined' && activePage === 'wol' ? 'text-primary font-semibold bg-primary/5' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container' %> transition-colors duration-200 rounded-xl"
          href="/wol"
        >
          <span class="material-symbols-outlined" data-icon="settings_remote"
            >settings_remote</span
          >
          <span class="font-label-md text-label-md">Daya Jarak Jauh</span>
        </a>
        <a
          class="flex items-center gap-3 px-4 py-3 <%= typeof activePage !== 'undefined' && activePage === 'deployer' ? 'text-primary font-semibold bg-primary/5' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container' %> transition-colors duration-200 rounded-xl"
          href="/deployer"
        >
          <span class="material-symbols-outlined" data-icon="rocket_launch"
            >rocket_launch</span
          >
          <span class="font-label-md text-label-md">Folder Deployer</span>
        </a>

        <a
          class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors duration-200 rounded-xl"
          href="#"
        >
          <span class="material-symbols-outlined" data-icon="settings"
            >settings</span
          >
          <span class="font-label-md text-label-md">Pengaturan</span>
        </a>
      </nav>
      <div class="mt-auto px-4 space-y-1">
        <button
          class="w-full mb-4 flex items-center justify-center gap-2 bg-primary text-on-primary py-3 rounded-xl font-label-md text-label-md hover:opacity-90 transition-opacity shadow-lg shadow-primary/20"
        >
          <span class="material-symbols-outlined" data-icon="add">add</span>
          Aset Baru
        </button>
        <a
          class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors duration-200 rounded-xl"
          href="#"
        >
          <span class="material-symbols-outlined" data-icon="help">help</span>
          <span class="font-label-md text-label-md">Dukungan</span>
        </a>
        <a
          class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors duration-200 rounded-xl"
          href="/logout"
        >
          <span class="material-symbols-outlined" data-icon="logout"
            >logout</span
          >
          <span class="font-label-md text-label-md">Keluar</span>
        </a>
      </div>
    </aside>

    <!-- TopNavBar -->
    <header
      class="fixed top-0 right-0 left-[260px] h-16 bg-surface-container-lowest/80 backdrop-blur-md border-b border-outline-variant flex justify-between items-center px-lg z-50"
    >
      <div class="flex items-center gap-4 flex-1 max-w-xl">
        <div class="relative w-full group">
          <span
            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none"
            data-icon="search"
            >search</span
          >
          <input
            class="w-full bg-surface-container border border-outline-variant rounded-xl py-2 pl-10 pr-4 font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
            placeholder="Cari aset infrastruktur..."
            type="text"
          />
        </div>
      </div>
      <div class="flex items-center gap-6">
        <div class="h-6 w-px bg-outline-variant"></div>
        <div class="flex items-center gap-4">
          <button
            class="text-on-surface-variant hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined" data-icon="notifications"
              >notifications</span
            >
          </button>
          <button
            class="text-on-surface-variant hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined" data-icon="terminal"
              >terminal</span
            >
          </button>
          <div
            class="flex items-center gap-3 ml-2 border-l border-outline-variant pl-4"
          >
            <div class="text-right">
              <p class="font-label-md text-label-md leading-none">
                <%= typeof userSession !== 'undefined' && userSession ?
                userSession.username : 'Admin User' %>
              </p>
              <p
                class="text-label-sm text-on-surface-variant uppercase tracking-widest mt-1 text-[10px]"
              >
                <%= typeof userSession !== 'undefined' && userSession ?
                userSession.groupName : 'Otoritas Lvl 4' %>
              </p>
            </div>
            <div
              class="w-8 h-8 rounded-full overflow-hidden bg-primary-container flex items-center justify-center font-bold text-primary text-xs"
            >
              <%= typeof userSession !== 'undefined' && userSession ?
              userSession.username.substring(0,2).toUpperCase() : 'AD' %>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="ml-[260px] pt-24 p-lg min-h-screen bg-surface">
