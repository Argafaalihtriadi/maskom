<script>
const exportData = <%- JSON.stringify(rawDataForExport) %>;

function exportCSV() {
    if(exportData.length === 0) return alert('Tidak ada data untuk diekspor.');
    let csvContent = "data:text/csv;charset=utf-8,";
    csvContent += "Filename,Hostname,IP Address,OS,NO DAT,Serial Number,Departemen,Pengguna\n";
    exportData.forEach(function(row) {
        var osSafe = '"' + (row.os || '').replace(/"/g, '""') + '"';
        csvContent += row.filename + ',' + row.hostname + ',' + row.ip + ',' + osSafe + ',' + row.dat + ',' + row.serial_number + ',' + row.departemen + ',' + row.pengguna + "\n";
    });
    var encodedUri = encodeURI(csvContent);
    var link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", "inventaris_aset.csv");
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

document.getElementById('csvFileInput').addEventListener('change', function(e) {
    var file = e.target.files[0];
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(evt) { processCSV(evt.target.result); };
    reader.readAsText(file);
    e.target.value = '';
});

function processCSV(csvText) {
    var lines = csvText.split('\n');
    if(lines.length < 2) return alert('File CSV kosong atau tidak valid.');
    var updates = [];
    for(var i=1; i<lines.length; i++) {
        var line = lines[i].trim();
        if(!line) continue;
        var cols = line.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/);
        var filename = cols[0];
        var dat = cols[4] !== undefined ? cols[4].replace(/(^"|"$)/g, '') : '';
        var serial_number = cols[5] !== undefined ? cols[5].replace(/(^"|"$)/g, '') : '';
        var departemen = cols[6] !== undefined ? cols[6].replace(/(^"|"$)/g, '') : '';
        var pengguna = cols[7] !== undefined ? cols[7].replace(/(^"|"$)/g, '') : '';
        if(filename) updates.push({ filename: filename, dat: dat, serial_number: serial_number, departemen: departemen, pengguna: pengguna });
    }
    if(updates.length === 0) return alert('Tidak ada data untuk diupdate.');
    if(!confirm('Ditemukan ' + updates.length + ' data untuk diupdate. Lanjutkan update massal?')) return;
    Promise.all(updates.map(function(u) {
        return fetch('/api/devices/' + u.filename, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dat: u.dat, serial_number: u.serial_number, departement: u.departemen, pengguna: u.pengguna })
        });
    })).then(function() {
        alert('Update massal selesai!');
        window.location.reload();
    }).catch(function() { alert('Terjadi kesalahan saat upload.'); });
}

// =============================================
// FILTER & PENCARIAN LANJUTAN
// =============================================

// Data per-baris untuk filter presisi (dari data EJS)
const rowFilterData = {};
document.querySelectorAll('#inventoryBody tr:not(#empty-row)').forEach(function(row) {
    const cells = row.querySelectorAll('td');
    // Kolom: 0=Nama, 1=DAT, 2=Serial, 3=Departemen, 4=User, 5=IP, 6=OS, 7=RAM, 8=Storage, 9=Status
    rowFilterData[row.rowIndex] = {
        text: row.textContent.toLowerCase(),
        departemen: cells[3] ? cells[3].textContent.trim().toLowerCase() : '',
        os: cells[6] ? cells[6].textContent.trim().toLowerCase() : '',
        status: cells[9] ? cells[9].textContent.trim().toLowerCase() : 'aktif'
    };
});

function applyFilters() {
    const keyword = (document.getElementById('searchInput').value || '').toLowerCase();
    const filterDep = (document.getElementById('filterDepartemen').value || '').toLowerCase();
    const filterOS = (document.getElementById('filterOS').value || '').toLowerCase();
    const filterStatus = (document.getElementById('filterStatus').value || '').toLowerCase();

    let visibleCount = 0;
    const rows = document.querySelectorAll('#inventoryBody tr:not(#empty-row)');
    rows.forEach(function(row) {
        const d = rowFilterData[row.rowIndex];
        if (!d) { row.style.display = ''; return; }

        const matchKeyword = !keyword || d.text.includes(keyword);
        const matchDep = !filterDep || d.departemen.includes(filterDep);
        const matchOS = !filterOS || d.os.includes(filterOS);
        const matchStatus = !filterStatus || d.status.includes(filterStatus);

        const visible = matchKeyword && matchDep && matchOS && matchStatus;
        row.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
    });

    // Update empty state
    const emptyRow = document.getElementById('empty-row');
    if (emptyRow) emptyRow.style.display = visibleCount === 0 ? '' : 'none';

    // Update badge
    const isFiltered = keyword || filterDep || filterOS || filterStatus;
    const badge = document.getElementById('filterBadge');
    if (isFiltered) {
        badge.classList.remove('hidden');
        const parts = [];
        if (keyword) parts.push('"' + keyword + '"');
        if (filterDep) parts.push('Departemen: ' + filterDep);
        if (filterOS) parts.push('OS: ' + filterOS);
        if (filterStatus) parts.push('Status: ' + filterStatus);
        document.getElementById('filterBadgeText').textContent = parts.join(' · ');
        document.getElementById('filterResultCount').textContent = visibleCount + ' perangkat ditemukan';
    } else {
        badge.classList.add('hidden');
    }
}

function clearFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('filterDepartemen').value = '';
    document.getElementById('filterOS').value = '';
    document.getElementById('filterStatus').value = '';
    applyFilters();
}

// Hubungkan search input ke applyFilters
document.getElementById('searchInput').addEventListener('keyup', applyFilters);

var modal = document.getElementById('deviceModal');
function openModal(filename, hostname, ip, mac, os, dat, serial_number, departemen, pengguna) {
    filename = filename || '';
    hostname = hostname || '';
    ip = ip || '';
    mac = mac || '';
    os = os || '';
    dat = dat || '';
    serial_number = serial_number || '';
    departemen = departemen || '';
    pengguna = pengguna || '';
    document.getElementById('editFilename').value = filename;
    document.getElementById('devHostname').value = hostname;
    document.getElementById('devIp').value = ip;
    document.getElementById('devMac').value = mac;
    document.getElementById('devOs').value = os;
    document.getElementById('devDat').value = dat;
    document.getElementById('devSerial').value = serial_number;
    document.getElementById('devDepartemen').value = departemen;
    document.getElementById('devPengguna').value = pengguna;
    document.getElementById('modalTitle').textContent = filename ? 'Edit Aset' : 'Tambah Aset';
    if(filename) {
        document.getElementById('devHostname').readOnly = true;
        document.getElementById('devHostname').classList.add('opacity-70');
    } else {
        document.getElementById('devHostname').readOnly = false;
        document.getElementById('devHostname').classList.remove('opacity-70');
    }
    modal.classList.remove('hidden');
}

function closeModal() { modal.classList.add('hidden'); }

function saveDevice() {
    var filename = document.getElementById('editFilename').value;
    var data = {
        hostname: document.getElementById('devHostname').value,
        ip: document.getElementById('devIp').value,
        mac: document.getElementById('devMac').value,
        os: document.getElementById('devOs').value,
        dat: document.getElementById('devDat').value,
        serial_number: document.getElementById('devSerial').value,
        departement: document.getElementById('devDepartemen').value,
        pengguna: document.getElementById('devPengguna').value
    };
    if(!data.hostname) { alert('Hostname wajib diisi'); return; }
    var url = filename ? '/api/devices/' + filename : '/api/devices';
    var method = filename ? 'PUT' : 'POST';
    fetch(url, {
        method: method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    }).then(function(res) { return res.json(); }).then(function(res) {
        if(res.success) { window.location.reload(); }
        else { alert('Error: ' + res.message); }
    }).catch(function() { alert('Terjadi kesalahan jaringan'); });
}

function deleteDevice(filename) {
    if(confirm('Anda yakin ingin menghapus aset ini? Data JSON akan dihapus secara permanen.')) {
        fetch('/api/devices/' + filename, { method: 'DELETE' })
        .then(function(res) { return res.json(); })
        .then(function(res) {
            if(res.success) { window.location.reload(); }
            else { alert('Error: ' + res.message); }
        }).catch(function() { alert('Terjadi kesalahan jaringan'); });
    }
}

// =============================================
// FTP Sync dari halaman Inventaris
// =============================================
let invSyncing = false;
async function syncFtpInventory() {
    if (invSyncing) return;
    const btn = document.getElementById('inv-sync-btn');
    const icon = document.getElementById('inv-sync-icon');
    const label = document.getElementById('inv-sync-label');

    invSyncing = true;
    btn.disabled = true;
    icon.style.animation = 'spin 1s linear infinite';
    label.textContent = 'Menyinkronkan...';

    try {
        const res = await fetch('/api/ftp/sync', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            showInvToast('✅ ' + data.message, 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            showInvToast('⚠️ ' + data.message, 'error');
        }
    } catch(e) {
        showInvToast('❌ Tidak dapat terhubung ke server.', 'error');
    } finally {
        invSyncing = false;
        btn.disabled = false;
        icon.style.animation = '';
        label.textContent = 'Sync FTP';
    }
}

function showInvToast(message, type) {
    const existing = document.getElementById('inv-toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.id = 'inv-toast';
    toast.style.cssText = `
        position:fixed;bottom:2rem;right:2rem;z-index:9999;
        padding:1rem 1.5rem;border-radius:1rem;
        font-size:0.875rem;font-weight:500;
        box-shadow:0 8px 32px rgba(0,0,0,0.25);
        backdrop-filter:blur(12px);
        animation:slideInToast 0.3s ease;
        max-width:380px;
        background:${type==='success'?'rgba(34,197,94,0.15)':'rgba(239,68,68,0.15)'};
        border:1px solid ${type==='success'?'rgba(34,197,94,0.4)':'rgba(239,68,68,0.4)'};
        color:${type==='success'?'#22c55e':'#ef4444'};
    `;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(()=>{ toast.style.animation='fadeOutToast 0.3s ease forwards'; setTimeout(()=>toast.remove(),300); },4000);
}

const invStyle = document.createElement('style');
invStyle.textContent = `
    @keyframes spin { from{transform:rotate(0deg)}to{transform:rotate(360deg)} }
    @keyframes slideInToast { from{opacity:0;transform:translateY(1rem)}to{opacity:1;transform:translateY(0)} }
    @keyframes fadeOutToast { from{opacity:1}to{opacity:0;transform:translateY(1rem)} }
`;
document.head.appendChild(invStyle);
</script>

