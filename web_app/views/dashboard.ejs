<%- include('partials/header', { title: 'Dasbor', activePage: 'dashboard' }) %>

<!-- Dasbor Header -->
<div class="flex items-end justify-between mb-8">
<div>
<h2 class="font-headline-lg text-headline-lg text-on-surface">Dasbor Utama</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Status real-time aset ProTech Infrastructure.</p>
</div>
<div class="flex flex-col items-end gap-2">
<div class="flex gap-3">
<button id="btn-ftp-sync" onclick="triggerFtpSync()" class="flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-xl font-label-md text-label-md hover:opacity-90 transition-opacity shadow-lg shadow-primary/20 disabled:opacity-50 disabled:cursor-not-allowed">
<span id="sync-icon" class="material-symbols-outlined" data-icon="sync">sync</span>
<span id="sync-label">Sync dari FTP</span>
</button>
</div>
<!-- Status sync terakhir -->
<div id="sync-status-bar" class="text-right">
<% if (syncState && syncState.lastSyncAt) { %>
<p class="font-mono-data text-[11px] <%= syncState.lastSyncStatus === 'success' ? 'text-status-success' : 'text-status-error' %>">
<span class="material-symbols-outlined text-xs align-middle"><%= syncState.lastSyncStatus === 'success' ? 'check_circle' : 'error' %></span>
<%= syncState.lastSyncMessage %> &bull; <span class="text-on-surface-variant"><%= new Date(syncState.lastSyncAt).toLocaleString('id-ID') %></span>
</p>
<% } else { %>
<p class="font-mono-data text-[11px] text-on-surface-variant">Belum pernah sync dari FTP.</p>
<% } %>
</div>
</div>
</div>
<!-- KPI Cards -->
