</div>
<div class="mt-4 flex items-center gap-2">
<div class="flex -space-x-1">
<div class="w-1.5 h-4 bg-status-success rounded-full"></div>
<div class="w-1.5 h-4 ml-1 bg-status-success rounded-full"></div>
<div class="w-1.5 h-4 ml-1 bg-status-success rounded-full"></div>
<div class="w-1.5 h-4 ml-1 bg-status-success rounded-full"></div>
<div class="w-1.5 h-4 ml-1 bg-surface-container rounded-full"></div>
