<%- include('partials/header', { title: 'Kontrol WOL', activePage: 'wol' }) %>

<style>
    @keyframes pulse-ring {
        0% { transform: scale(0.95); opacity: 0.5; }
        50% { transform: scale(1.05); opacity: 0.3; }
        100% { transform: scale(0.95); opacity: 0.5; }
    }
    .animate-pulse-ring {
        animation: pulse-ring 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    .console-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .console-scrollbar::-webkit-scrollbar-track {
        background: #f2f4f6;
    }
    .console-scrollbar::-webkit-scrollbar-thumb {
        background: #c7c4d7;
        border-radius: 2px;
    }
</style>

<!-- Main Content Area -->
<div class="flex-1 p-container-padding max-w-6xl mx-auto w-full mt-4">
<div class="flex flex-col gap-8">
<!-- Page Title -->
<div class="flex justify-between items-end">
<div>
<h2 class="font-headline-md text-headline-md text-on-background">Kontrol Wake-on-LAN</h2>
<p class="text-on-surface-variant font-body-md mt-1">Manajemen daya jarak jauh untuk infrastruktur misi kritis.</p>
</div>
<div class="flex gap-3">
<div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-status-success/10 border border-status-success/20">
<div class="w-2 h-2 rounded-full bg-status-success"></div>
<span class="text-status-success text-label-md font-label-md">Layanan WOL Aktif</span>
</div>
</div>
</div>
<!-- Main Layout Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
<!-- Left Column: Target Selector & Details -->
<div class="lg:col-span-6 flex flex-col gap-gutter">
<!-- Device Selector List (Multi-Select) -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 shadow-sm flex flex-col h-[500px]">
<div class="flex justify-between items-center mb-4">
    <label class="text-label-sm font-label-sm text-on-surface-variant uppercase">Pilih Perangkat</label>
    <div class="flex items-center gap-2">
        <input type="checkbox" id="selectAll" class="rounded text-primary focus:ring-primary h-4 w-4">
        <label for="selectAll" class="text-sm font-label-md text-on-surface cursor-pointer">Pilih Semua</label>
    </div>
</div>
<div class="flex gap-2 mb-4">
    <div class="relative flex-1">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm">search</span>
        <input id="searchWol" type="text" class="w-full bg-surface-container border border-outline-variant rounded-xl pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Cari hostname atau IP...">
    </div>
    <select id="filterDepartemen" class="bg-surface-container border border-outline-variant rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary min-w-[150px]">
        <option value="">Semua Bagian</option>
        <% 
            const depts = new Set();
            if(typeof devices !== 'undefined') {
                devices.forEach(d => {
                    if(d.data.Departemen) depts.add(d.data.Departemen);
                });
            }
            Array.from(depts).sort().forEach(dept => { 
        %>
            <option value="<%= dept %>"><%= dept %></option>
        <% }); %>
    </select>
</div>

<div class="flex-1 overflow-y-auto custom-scrollbar border border-outline-variant rounded-lg" id="deviceList">
<% if(typeof devices !== 'undefined' && devices.length > 0) { %>
    <% devices.forEach(function(device, idx) { 
        const userInfo = device.data["User Session (Whoami)"];
        let ipAddress = 'Unknown';
        let macAddress = '';
        if (device.data["LAN/Network Card"] && device.data["LAN/Network Card"].length > 0) {
            const connectedCard = device.data["LAN/Network Card"].find(c => c["Status Hardware"] && c["Status Hardware"].includes("Connected"));
            if (connectedCard) {
                ipAddress = connectedCard["IPv4 Address"];
                macAddress = connectedCard["Physical Address (MAC)"];
            } else {
                ipAddress = device.data["LAN/Network Card"][0]["IPv4 Address"];
                macAddress = device.data["LAN/Network Card"][0]["Physical Address (MAC)"];
            }
        }
        const hostname = userInfo ? userInfo.Hostname : device.filename;
        if(macAddress) {
    %>
    <label class="device-item flex items-center justify-between p-3 border-b border-outline-variant/30 hover:bg-surface-container-low cursor-pointer transition-colors" data-departemen="<%= device.data.Departemen || '' %>">
        <div class="flex items-center gap-3">
            <input type="checkbox" value="<%= macAddress %>" data-ip="<%= ipAddress %>" data-hostname="<%= hostname %>" class="device-checkbox rounded text-primary focus:ring-primary h-4 w-4">
            <div>
                <p class="font-bold text-sm text-on-surface hostname-label"><%= hostname %></p>
                <div class="flex items-center gap-2 mt-0.5">
                    <span class="ping-indicator w-2 h-2 rounded-full bg-on-surface-variant/30 shrink-0" title="Menunggu ping..." data-ping-ip="<%= ipAddress %>"></span>
                    <p class="text-xs text-on-surface-variant font-mono ip-label"><%= ipAddress %></p>
                    <% if(device.data.Departemen) { %>
                        <span class="text-[10px] bg-primary/10 text-primary px-1.5 py-0.5 rounded-sm whitespace-nowrap"><%= device.data.Departemen %></span>
                    <% } %>
                </div>
            </div>
        </div>
        <span class="text-xs text-on-surface-variant font-mono"><%= macAddress %></span>
    </label>
    <%  } }); %>
<% } else { %>
    <div class="p-4 text-center text-on-surface-variant text-sm">Tidak ada perangkat.</div>
<% } %>
</div>
<div class="mt-4 flex justify-between items-center bg-surface-container-low p-2 rounded-lg border border-outline-variant/50">
    <span class="text-sm text-on-surface-variant font-label-md">Dipilih:</span>
    <span id="selectedCount" class="font-bold text-primary text-sm">0 perangkat</span>
</div>
</div>
</div>
<!-- Right Column: Control Center -->
<div class="lg:col-span-6 flex flex-col gap-gutter">
<!-- The Magic Packet Center -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 flex flex-col items-center justify-center text-center relative overflow-hidden shadow-sm flex-1">
<!-- Background glow effect -->
<div class="absolute w-64 h-64 bg-primary/5 blur-[100px] rounded-full -top-32 -right-32"></div>
<h3 class="text-headline-md font-headline-md mb-6 text-on-background">Kirim Magic Packet Jamak</h3>
<div class="relative z-10 mb-6">
<div class="w-24 h-24 rounded-full border-4 border-primary/10 flex items-center justify-center relative">
<div class="absolute inset-0 rounded-full border-2 border-primary/20 animate-pulse-ring"></div>
<span class="material-symbols-outlined text-[48px] text-primary" style="font-variation-settings: 'FILL' 1;">power_settings_new</span>
</div>
</div>
<button class="relative z-10 bg-primary hover:opacity-90 text-on-primary font-headline-sm text-headline-sm px-8 py-4 rounded-xl shadow-lg transition-all active:scale-[0.95] flex items-center gap-3 group" id="send-wol">
                            WAKE SELECTED
                            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">bolt</span>
</button>
</div>
<!-- Console Log -->
<div class="bg-surface-container-low border border-outline-variant rounded-xl overflow-hidden flex flex-col h-[230px] shadow-sm">
<div class="bg-surface-container px-4 py-2 border-b border-outline-variant flex justify-between items-center">
<div class="flex items-center gap-2">
<span class="w-3 h-3 rounded-full bg-status-error/40"></span>
<span class="w-3 h-3 rounded-full bg-status-warning/40"></span>
<span class="w-3 h-3 rounded-full bg-status-success/40"></span>
<span class="ml-2 font-mono-data text-label-sm text-on-surface-variant uppercase tracking-widest">Terminal Proses</span>
</div>
<button class="text-on-surface-variant hover:text-on-surface transition-colors" id="clear-log">
<span class="material-symbols-outlined text-[18px]">delete_sweep</span>
</button>
</div>
<div class="p-4 font-mono-data text-mono-data text-on-surface-variant flex-1 overflow-y-auto console-scrollbar bg-surface-container-lowest" id="console-output">
<div class="mb-1 opacity-60">Menginisialisasi Kontroler WOL v4.2.1...</div>
<div class="mb-1 text-primary font-semibold">Sistem siap. Menunggu pilihan perangkat.</div>
<div class="mb-1 text-on-surface-variant">_</div>
</div>
</div>
</div>
</div>
</div>

<script>
    // Selection logic
    const selectAllCheckbox = document.getElementById('selectAll');
    const deviceCheckboxes = document.querySelectorAll('.device-checkbox');
    const selectedCountDisplay = document.getElementById('selectedCount');

    function updateSelectedCount() {
        const checked = document.querySelectorAll('.device-checkbox:checked').length;
        selectedCountDisplay.textContent = `${checked} perangkat`;
    }

    selectAllCheckbox.addEventListener('change', (e) => {
        const isChecked = e.target.checked;
        deviceCheckboxes.forEach(cb => {
            // only check visible items if using search
            if (cb.closest('.device-item').style.display !== 'none') {
                cb.checked = isChecked;
            }
        });
        updateSelectedCount();
    });

    deviceCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateSelectedCount);
    });

    // Filter & Search Logic
    const searchWol = document.getElementById('searchWol');
    const filterDepartemen = document.getElementById('filterDepartemen');
    const items = document.querySelectorAll('.device-item');

    function applyFilters() {
        const keyword = searchWol.value.toLowerCase();
        const dept = filterDepartemen.value;

        items.forEach(item => {
            const hostname = item.querySelector('.hostname-label').textContent.toLowerCase();
            const ip = item.querySelector('.ip-label').textContent.toLowerCase();
            const itemDept = item.getAttribute('data-departemen');
            
            const matchKeyword = hostname.includes(keyword) || ip.includes(keyword);
            const matchDept = dept === '' || itemDept === dept;

            if (matchKeyword && matchDept) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
        
        selectAllCheckbox.checked = false;
        deviceCheckboxes.forEach(cb => {
            if (cb.closest('.device-item').style.display === 'none') {
                cb.checked = false;
            }
        });
        updateSelectedCount();
    }

    searchWol.addEventListener('keyup', applyFilters);
    filterDepartemen.addEventListener('change', applyFilters);


    // WOL execution logic
    const btn = document.getElementById('send-wol');
    const consoleOutput = document.getElementById('console-output');
    const clearBtn = document.getElementById('clear-log');

    function addLog(message, type = 'default') {
        const div = document.createElement('div');
        div.className = 'mb-1 animate-in fade-in slide-in-from-left-2 duration-300';
        
        const timestamp = new Array(1).fill(new Date().toLocaleTimeString('id-ID', { hour12: false })).join('');
        const prefix = `<span class="opacity-40">[${timestamp}]</span> `;
        
        if (type === 'success') {
            div.innerHTML = `${prefix}<span class="text-status-success font-semibold">${message}</span>`;
        } else if (type === 'error') {
            div.innerHTML = `${prefix}<span class="text-status-error font-semibold">${message}</span>`;
        } else if (type === 'process') {
            div.innerHTML = `${prefix}<span class="text-primary font-semibold">${message}</span>`;
        } else {
            div.innerHTML = `${prefix}${message}`;
        }

        consoleOutput.appendChild(div);
        consoleOutput.scrollTop = consoleOutput.scrollHeight;
    }

    btn.addEventListener('click', () => {
        const selected = Array.from(document.querySelectorAll('.device-checkbox:checked'));
        if (selected.length === 0) {
            addLog('Gagal: Pilih setidaknya satu perangkat.', 'error');
            return;
        }
        
        const macs = selected.map(cb => cb.value);
        
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
        
        addLog(`Memulai broadcast Magic Packet untuk ${macs.length} perangkat...`, 'process');
        
        setTimeout(() => {
            addLog('Mengirimkan payload ke jaringan lokal...', 'process');
            
            fetch('/api/wol', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ macs: macs })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    addLog(data.message, 'success');
                } else {
                    addLog(`Error: ${data.message}`, 'error');
                }
            })
            .catch(err => {
                addLog('Koneksi ke backend gagal.', 'error');
            })
            .finally(() => {
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
            });

        }, 1000);
    });

    clearBtn.addEventListener('click', () => {
        consoleOutput.innerHTML = '<div class="mb-1 text-primary font-semibold">Terminal dibersihkan. Sistem siap.</div><div class="mb-1 text-on-surface-variant">_</div>';
    });

    setInterval(() => {
        const lines = consoleOutput.querySelectorAll('div');
        const lastLine = lines[lines.length - 1];
        if (lastLine && lastLine.textContent === '_') {
            lastLine.style.opacity = lastLine.style.opacity === '0' ? '1' : '0';
        }
    }, 500);

    // Real-time Ping Polling
    async function doPing(ip) {
        try {
            const res = await fetch(`/api/ping?ip=${ip}`);
            const data = await res.json();
            return data;
        } catch (e) {
            return { success: false };
        }
    }

    async function pingVisibleDevices() {
        // Find visible devices and their ping indicators
        const visibleIndicators = Array.from(document.querySelectorAll('.device-item'))
            .filter(item => item.style.display !== 'none')
            .map(item => item.querySelector('.ping-indicator'))
            .filter(indicator => indicator);
        
        // Execute sequentially or in small batches
        const batchSize = 5;
        for (let i = 0; i < visibleIndicators.length; i += batchSize) {
            const batch = visibleIndicators.slice(i, i + batchSize);
            await Promise.all(batch.map(async (indicator) => {
                const ip = indicator.getAttribute('data-ping-ip');
                if(ip && ip !== 'Unknown' && ip !== '0.0.0.0') {
                    // indicate pinging
                    indicator.classList.remove('bg-status-success', 'bg-status-error', 'bg-on-surface-variant/30');
                    indicator.classList.add('bg-primary/50', 'animate-pulse');
                    
                    const result = await doPing(ip);
                    
                    indicator.classList.remove('bg-primary/50', 'animate-pulse');
                    if (result.success && result.alive) {
                        indicator.classList.add('bg-status-success');
                        indicator.title = `Online (${result.time}ms)`;
                    } else {
                        indicator.classList.add('bg-status-error');
                        indicator.title = 'Offline';
                    }
                }
            }));
        }
    }
    
    // Initial ping and start interval (10 seconds)
    pingVisibleDevices();
    setInterval(pingVisibleDevices, 10000);

    // Also trigger ping when filters change to immediately ping newly visible items
    filterDepartemen.addEventListener('change', () => { setTimeout(pingVisibleDevices, 500); });
    searchWol.addEventListener('keyup', () => { setTimeout(pingVisibleDevices, 500); });
</script>

<%- include('partials/footer') %>
