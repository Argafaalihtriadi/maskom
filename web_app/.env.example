# ================================================
# Contoh konfigurasi .env untuk MaskomApp
# Salin file ini menjadi .env dan isi nilainya
# ================================================

PORT=3000

# FTP Server
FTP_HOST=192.168.33.181
FTP_USER=
FTP_PASS=
FTP_PATH=/maskom
FTP_PORT=21

# Cron schedule (kosongkan untuk nonaktifkan)
FTP_SYNC_CRON=0 */1 * * *

# Cooldown sync manual (detik)
FTP_SYNC_COOLDOWN=30

# Path VNC Viewer
VNC_PATH=
